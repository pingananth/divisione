# --- Site -----------------------------------------------------------------
# Public origin, used to build the organiser magic-link redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email ----------------------------------------------------------------
# One of: resend | brevo | smtp | console
# "console" logs instead of sending, which is what local and staging should use.
EMAIL_PROVIDER=console
EMAIL_FROM=registrations@your-domain.org
EMAIL_FROM_NAME=Toastmasters District 229

# Only the block for the selected provider needs filling in.
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Jobs -----------------------------------------------------------------
# Shared secret required by /api/cron/outbox.
CRON_SECRET=generate-a-long-random-string
